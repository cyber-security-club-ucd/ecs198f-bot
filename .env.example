# ECS 198F Discord Bot — Environment Configuration
# Copy this file to .env and fill in your values.

# ── Discord ──────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_bot_token_here
# Guild (server) where the bot operates and assigns roles
DISCORD_GUILD_ID=your_guild_id_here
# Text channel where the persistent "Authenticate" button is posted
ECS198F_AUTH_CHANNEL_ID=your_auth_channel_id_here
# Discord role ID assigned to verified 198F-student members
ECS198F_STUDENT_ROLE_ID=your_ecs198f_student_role_id_here

# ── Authentik OIDC ────────────────────────────────────────────────────────────
AUTHENTIK_URL=https://auth.daviscybersec.org
AUTHENTIK_OIDC_URL=https://auth.daviscybersec.org/application/o/discord-bot/
AUTHENTIK_CLIENT_ID=your_oauth_client_id
AUTHENTIK_SECRET=your_oauth_client_secret

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your_random_secret_key_here
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,bot.daviscybersec.org
BASE_URL=https://bot.daviscybersec.org

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ecs198f
DB_USER=ecs198f
DB_PASSWORD=your_secure_password_here

# ── Web Server ────────────────────────────────────────────────────────────────
WEB_PORT=8000
GUNICORN_WORKERS=2

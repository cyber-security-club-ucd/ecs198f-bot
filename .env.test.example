# ECS 198F Bot — Test Environment Configuration
# Copy to .env.test for running integration/browser tests.

# Test Database (Docker)
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_NAME=ecs198f_test
TEST_DB_USER=test_user
TEST_DB_PASSWORD=test_password

# Django
DJANGO_SECRET_KEY=test-secret-key-not-for-production
DJANGO_DEBUG=True
BASE_URL=http://localhost:8000

# Authentik (test credentials — NON-PRODUCTION accounts only)
AUTHENTIK_URL=https://auth.daviscybersec.org
AUTHENTIK_OIDC_URL=https://auth.daviscybersec.org/application/o/discord-bot/
AUTHENTIK_CLIENT_ID=your_test_oauth_client_id
AUTHENTIK_SECRET=your_test_oauth_client_secret

# Discord (test bot)
TEST_DISCORD_USER_TOKEN=your_test_user_discord_token_here
TEST_GUILD_ID=your_test_guild_id_here
